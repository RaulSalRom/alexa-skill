# ============================================
# Configuración del Webhook Alexa ↔ OpenClaw
# ============================================
# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env

# URL de la API OpenAI-compatible de OpenClaw Gateway
# OPENCLAW_URL=http://IP_DEL_SERVIDOR:18789/v1/chat/completions

# Token de autenticación del Gateway de OpenClaw
# Lo encuentras en ~/.openclaw/openclaw.json → gateway.auth.token
# OPENCLAW_TOKEN=tu_token_aqui

# Modelo a usar en OpenClaw (por defecto: openclaw/default)
# OPENCLAW_MODEL=openclaw/default

# Puerto y host del webhook
# PORT=5000
# HOST=0.0.0.0
